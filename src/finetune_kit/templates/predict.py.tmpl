#!/usr/bin/env python3
"""Standalone predictor exported by `finetune-kit promote` (experiment {{EXPERIMENT}}, run {{RUN}}).

Needs only torch and transformers (plus peft when recipe.json has lora_r > 0); it does not
import finetune-kit. Loads model/, recipe.json and threshold.json (if present) from its own folder.

    python predict.py --input rows.jsonl --output scores.jsonl [--device cpu]

seq-cls: input rows need "text"; output rows are {"id", "label", "score"} where score is the
positive-class probability, plus "flag" (score >= threshold) when threshold.json exists.
token-cls: input rows need "tokens"; output rows are {"id", "tags"}.

Generated by finetune-kit {{VERSION}}.
"""
import argparse
import contextlib
import json
from pathlib import Path

import torch
from torch import nn

HERE = Path(__file__).resolve().parent
EVAL_BATCH = 16


class Pool(nn.Module):
    def __init__(self, cfg, hidden):
        super().__init__()
        self.kind = cfg["pooling"]
        if self.kind == "attention":
            self.attn = nn.Linear(hidden, 1)
        if self.kind == "weighted_layers":
            self.layer_weights = nn.Parameter(torch.zeros(cfg["pool_layers"]))
        self.n_layers = cfg["pool_layers"]

    def forward(self, out, attention_mask):
        h = out.last_hidden_state
        if self.kind == "mean":
            m = attention_mask.unsqueeze(-1).to(h.dtype)
            return (h * m).sum(1) / m.sum(1).clamp(min=1.0)
        if self.kind == "attention":
            scores = self.attn(h).squeeze(-1).masked_fill(attention_mask == 0, float("-inf"))
            return (torch.softmax(scores, -1).unsqueeze(-1) * h).sum(1)
        if self.kind == "weighted_layers":
            cls = torch.stack([s[:, 0] for s in out.hidden_states[-self.n_layers:]], 1)
            w = torch.softmax(self.layer_weights, 0).to(cls.dtype)
            return (w[None, :, None] * cls).sum(1)
        return h[:, 0]


def make_head(cfg, hidden, n_out):
    if cfg["head"] == "mlp":
        return nn.Sequential(
            nn.Dropout(cfg["dropout"]), nn.Linear(hidden, hidden), nn.GELU(),
            nn.Dropout(cfg["dropout"]), nn.Linear(hidden, n_out),
        )
    return nn.Sequential(nn.Dropout(cfg["dropout"]), nn.Linear(hidden, n_out))


class CRF(nn.Module):
    """Viterbi decoding with the parameters of a trained pytorch-crf CRF layer."""

    def __init__(self, n_tags):
        super().__init__()
        self.start_transitions = nn.Parameter(torch.zeros(n_tags))
        self.end_transitions = nn.Parameter(torch.zeros(n_tags))
        self.transitions = nn.Parameter(torch.zeros(n_tags, n_tags))

    def viterbi(self, emissions):
        """emissions: (length, n_tags) -> best tag path."""
        if len(emissions) == 0:
            return []
        score = self.start_transitions + emissions[0]
        history = []
        for i in range(1, len(emissions)):
            score, idx = (score[:, None] + self.transitions + emissions[i][None, :]).max(0)
            history.append(idx)
        best = [int((score + self.end_transitions).argmax())]
        for idx in reversed(history):
            best.append(int(idx[best[-1]]))
        return best[::-1]


class SeqClassifier(nn.Module):
    def __init__(self, backbone, n_classes, cfg):
        super().__init__()
        self.backbone = backbone
        hidden = backbone.config.hidden_size
        self.pool = Pool(cfg, hidden)
        self.head = make_head(cfg, hidden, n_classes)
        self.needs_hidden = cfg["pooling"] == "weighted_layers"

    def forward(self, input_ids, attention_mask):
        kw = {"output_hidden_states": True} if self.needs_hidden else {}
        out = self.backbone(input_ids=input_ids, attention_mask=attention_mask, **kw)
        return self.head(self.pool(out, attention_mask))


class TokenClassifier(nn.Module):
    def __init__(self, backbone, n_tags, cfg):
        super().__init__()
        self.backbone = backbone
        self.head = make_head(cfg, backbone.config.hidden_size, n_tags)
        self.crf = CRF(n_tags) if cfg["crf"] else None

    def forward(self, input_ids, attention_mask):
        h = self.backbone(input_ids=input_ids, attention_mask=attention_mask).last_hidden_state
        return self.head(h)


def pick_device():
    if torch.cuda.is_available():
        return "cuda"
    if torch.backends.mps.is_available():
        return "mps"
    return "cpu"


def load(device):
    from transformers import AutoConfig, AutoModel, AutoTokenizer

    recipe = json.loads((HERE / "recipe.json").read_text())
    cfg, prof = recipe["config"], recipe["profile"]
    kw = {"trust_remote_code": bool(prof.get("trust_remote_code"))}
    mdir = HERE / "model"
    backbone = AutoModel.from_config(AutoConfig.from_pretrained(mdir, **kw), **kw)
    if cfg["lora_r"] > 0:
        from peft import LoraConfig, get_peft_model

        backbone = get_peft_model(backbone, LoraConfig(
            r=cfg["lora_r"], lora_alpha=cfg["lora_alpha"], target_modules=prof["lora_targets"],
            lora_dropout=0.05,
        ))
    n = len(recipe["labels"])
    cls = TokenClassifier if recipe["task"] == "token-cls" else SeqClassifier
    model = cls(backbone, n, cfg)
    model.load_state_dict(torch.load(mdir / "classifier.pt", map_location="cpu", weights_only=True))
    tok = AutoTokenizer.from_pretrained(mdir, **kw)
    return recipe, model.to(device).eval(), tok


def autocast(device, cfg):
    if cfg["precision"] == "bf16":
        return torch.autocast(device_type=device, dtype=torch.bfloat16)
    return contextlib.nullcontext()


def pad(rows, pad_id, device):
    n = max(len(r) for r in rows)
    ids = torch.full((len(rows), n), pad_id, dtype=torch.long)
    mask = torch.zeros((len(rows), n), dtype=torch.long)
    for i, r in enumerate(rows):
        ids[i, : len(r)] = torch.tensor(r)
        mask[i, : len(r)] = 1
    return ids.to(device), mask.to(device)


def batches(ids):
    """Index batches in length order (as at training-time evaluation)."""
    order = sorted(range(len(ids)), key=lambda i: len(ids[i]))
    for b in range(0, len(order), EVAL_BATCH):
        yield order[b : b + EVAL_BATCH]


@torch.no_grad()
def predict_seq(model, tok, cfg, texts, device):
    ids = tok(texts, truncation=True, max_length=cfg["max_len"], verbose=False)["input_ids"]
    probs = [None] * len(ids)
    for idx in batches(ids):
        x, mask = pad([ids[i] for i in idx], tok.pad_token_id, device)
        with autocast(device, cfg):
            logits = model(x, mask)
        p = torch.softmax(logits.float(), -1).cpu().double()
        p = p / p.sum(1, keepdim=True)
        for r, i in enumerate(idx):
            probs[i] = p[r].tolist()
    return probs


@torch.no_grad()
def predict_tokens(model, tok, cfg, labels, tokens, device):
    enc = tok(tokens, is_split_into_words=True, truncation=True, max_length=cfg["max_len"], verbose=False)
    ids = enc["input_ids"]
    words, keep = [], []
    for i in range(len(ids)):
        w_ids, kept, prev = enc.word_ids(i), [], None
        for j, w in enumerate(w_ids):
            if w is not None and (w != prev or cfg["label_align"] == "all"):
                kept.append(j)
            prev = w
        words.append(w_ids)
        keep.append(kept)
    out = [["O"] * len(t) for t in tokens]
    for idx in batches(ids):
        x, mask = pad([ids[i] for i in idx], tok.pad_token_id, device)
        with autocast(device, cfg):
            logits = model(x, mask).float()
        for r, i in enumerate(idx):
            em = logits[r, keep[i]]
            path = model.crf.viterbi(em) if model.crf is not None else em.argmax(-1).tolist()
            seen = set()
            for j, tag in zip(keep[i], path):
                w = words[i][j]
                if w not in seen:
                    seen.add(w)
                    out[i][w] = labels[tag]
    return out


def main(argv=None):
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("--input", required=True, help="JSONL rows with text (seq-cls) or tokens (token-cls)")
    ap.add_argument("--output", required=True, help="JSONL predictions")
    ap.add_argument("--device", default=None, help="cpu, cuda or mps (default: best available)")
    a = ap.parse_args(argv)
    device = a.device or pick_device()
    recipe, model, tok = load(device)
    cfg, labels = recipe["config"], recipe["labels"]
    with open(a.input) as f:
        rows = [json.loads(line) for line in f if line.strip()]
    ids = [r.get("id", n) for n, r in enumerate(rows)]
    if recipe["task"] == "token-cls":
        tags = predict_tokens(model, tok, cfg, labels, [r["tokens"] for r in rows], device) if rows else []
        out = [{"id": i, "tags": t} for i, t in zip(ids, tags)]
    else:
        tp = HERE / "threshold.json"
        threshold = json.loads(tp.read_text())["threshold"] if tp.is_file() else None
        pos = recipe["positive_index"]
        probs = predict_seq(model, tok, cfg, [r["text"] for r in rows], device) if rows else []
        out = []
        for i, p in zip(ids, probs):
            item = {"id": i, "label": labels[max(range(len(p)), key=p.__getitem__)], "score": p[pos]}
            if threshold is not None:
                item["flag"] = p[pos] >= threshold
            out.append(item)
    with open(a.output, "w") as f:
        f.write("".join(json.dumps(o) + "\n" for o in out))


if __name__ == "__main__":
    main()
